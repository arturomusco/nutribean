---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Fiere | NutriBean+">
  <div class="page-container about-page">
    
    <!-- Tab identiche a About Us -->
    <nav class="author-tabs">
      <a href="#italy" class="author-tab-btn">I Giovani e le Scienze</a>
      <a href="#europe" class="author-tab-btn">EUCYS Bruxelles</a>
      <a href="#world" class="author-tab-btn">Fiera Internazionale</a>
    </nav>

    <!-- ================= SEZIONE 1: ITALIA ================= -->
    <section id="italy" class="fiere-section">
      <span class="fiere-eyebrow">Where it all started…</span>
      
      <div class="fiere-split">
        <div class="fiere-text-col">
          <h2 class="fiere-title">FAST – "I Giovani e le Scienze" (Milan, March 2023)</h2>
          <p class="fiere-description">
Our journey began in Milan at the FAST national competition "I Giovani e le Scienze", where we presented NutriBean+ outside our school walls for the very first time. What struck us most wasn't just the excitement of sharing our laboratory results with the jury, but discovering a community of young people just like us—curious, passionate, and eager to discuss ideas. Alongside winning First Prize overall, we were honored with the special award from the Italian Chemical Society (SCI), the USAID award for technological and environmental innovation, and official accreditation to represent Italy at both EUCYS in Brussels and ESI in Mexico. Beyond the awards, exploring other students' projects taught us how rewarding it is to share science openly, learning as much from our peers' questions as from our own experiments.
          </p>
        </div>

        <div class="fiere-carousel-col">
          <div class="mini-carousel" data-carousel>
            <div class="mini-slide active">
              <img src="/foto i giovani/1. EUCYS accreditation from Giuseppe Valditara (Education Prime Minister).jpg" alt="Stand Milano" loading="lazy" decoding="async" />
              <p class="mini-caption">EUCYS accreditation from Giuseppe Valditara (Education Prime Minister)</p>
            </div>
            <div class="mini-slide">
              <img src="/foto i giovani/award.avif" alt="Premiazione Milano" loading="lazy" decoding="async" />
              <p class="mini-caption">Italian Chemistry Society award</p>
            </div>
            <div class="mini-slide">
              <img src="/foto i giovani/3. USAID award.avif" alt="Team Milano" loading="lazy" decoding="async" />
              <p class="mini-caption">USAID award</p>
            </div>
            <div class="mini-slide">
              <img src="/foto i giovani/4. happy to be there!.jpg" alt="Stand Milano" loading="lazy" decoding="async" />
              <p class="mini-caption">Happy to be there!</p>
            </div>
            <div class="mini-slide">
              <img src="/foto i giovani/5. exposition time.jpg" alt="Premiazione Milano" loading="lazy" decoding="async" />
              <p class="mini-caption">Exposition time</p>
            </div>
            <div class="mini-slide">
              <img src="/foto i giovani/team.jpg" alt="Premiazione Milano" loading="lazy" decoding="async" />
              <p class="mini-caption">Our team</p>
            </div> 
            <div class="mini-slide">
              <img src="/foto i giovani/7.  visiting milan.jpg" alt="Team Milano" loading="lazy" decoding="async" />
              <p class="mini-caption">Visiting milan</p>
            </div>
            <div class="mini-slide">
              <img src="/foto i giovani/8. our team the final day.jpg" alt="Stand Milano" loading="lazy" decoding="async" />
              <p class="mini-caption">Our team the final day</p>
            </div>
            <div class="mini-slide">
              <img src="/foto i giovani/9. all participants.jpg" alt="Premiazione Milano" loading="lazy" decoding="async" />
              <p class="mini-caption">All participants</p>
            </div>
            <div class="mini-slide">
              <img src="/foto i giovani/10. dismantling our stand.jpg" alt="Team Milano" loading="lazy" decoding="async" />
              <p class="mini-caption">Dismantling our stand</p>
            </div>

            <button class="mini-arrow prev" aria-label="Precedente">&#10094;</button>
            <button class="mini-arrow next" aria-label="Successiva">&#10095;</button>
          </div>
        </div>
      </div>
    </section>

    <hr class="section-divider" />

    <!-- ================= SEZIONE 2: EUROPA ================= -->
    <section id="europe" class="fiere-section">
      <span class="fiere-eyebrow">In Europe…</span>
      
      <div class="fiere-split">
        <div class="fiere-text-col">
          <h2 class="fiere-title">EUCYS – European Union Contest for Young Scientists (Brussels, September 2023)</h2>
          <p class="fiere-description">
            Representing Italy at EUCYS in Brussels was our very first major international fair, and it completely blew us away. Suddenly, we were surrounded by young researchers from dozens of countries, each bringing unique perspectives, cultures, and scientific approaches. One of the best memories from those days was the collectible sticker album created by the organizers, featuring the faces of all the participants, organizers, and volunteers—trading stickers across the venue became the ultimate icebreaker to meet everyone and spark new friendships, many of which are still going strong today! Between exchanging feedback at the stands, cheering for one another, and enjoying local Belgian specialties like crispy fries, waffles, and chocolate together, we realized that science truly thrives on collaboration and human connection.
          </p>
        </div>

        <div class="fiere-carousel-col">
          <div class="mini-carousel" data-carousel>
            <div class="mini-slide active">
              <img src="/1. departures of the italian delegation from Italy.jpg" alt="Stand Bruxelles" loading="lazy" decoding="async" />
              <p class="mini-caption">Departures of the italian delegation from Italy</p>
            </div>
            <div class="mini-slide">
              <img src="/2. Alberto Pieri and us in front of our stand.jpg" alt="Presentazione EUCYS" loading="lazy" decoding="async" />
              <p class="mini-caption">Alberto Pieri and us in front of our stand</p>
            </div>
            <div class="mini-slide">
              <img src="/3. our stand2.jpg" alt="Team EUCYS" loading="lazy" decoding="async" />
              <p class="mini-caption">Our stand</p>
            </div>

            <div class="mini-slide">
              <img src="/4. all italian delegation.jpg" alt="Stand Bruxelles" loading="lazy" decoding="async" />
              <p class="mini-caption">All italian delegation</p>
            </div>
            <div class="mini-slide">
              <img src="/5. candid shot in front of our stand.jpg" alt="Presentazione EUCYS" loading="lazy" decoding="async" />
              <p class="mini-caption">Candid shot in front of our stand</p>
            </div>
            <div class="mini-slide">
              <img src="/6. all participants.jpg" alt="Team EUCYS" loading="lazy" decoding="async" />
              <p class="mini-caption">All participants</p>
            </div>

           <div class="mini-slide">
              <img src="/7. all italian participants at the closing ceremony .jpg" alt="Stand Bruxelles" loading="lazy" decoding="async" />
              <p class="mini-caption">All italian participants at the closing ceremony </p>
            </div>
            <div class="mini-slide">
              <img src="/8. funny picture at the closing ceremony!.jpg" alt="Presentazione EUCYS" loading="lazy" decoding="async" />
              <p class="mini-caption">Funny picture at the closing ceremony!</p>
            </div>
            <div class="mini-slide">
              <img src="/9. departures from Bruxelles.jpg" alt="Team EUCYS" loading="lazy" decoding="async" />
              <p class="mini-caption">Departures from Bruxelles</p>
            </div>


            <button class="mini-arrow prev" aria-label="Precedente">&#10094;</button>
            <button class="mini-arrow next" aria-label="Successiva">&#10095;</button>
          </div>
        </div>
      </div>
    </section>

    <hr class="section-divider" />

    <!-- ================= SEZIONE 3: MONDO ================= -->
    <section id="world" class="fiere-section">
      <span class="fiere-eyebrow">… and then across the world </span>
      
      <div class="fiere-split">
        <div class="fiere-text-col">
          <h2 class="fiere-title">ESI – MILSET Expo-Sciences International (Puebla, Mexico, October 2023)</h2>
          <p class="fiere-description">
Flying across the ocean to Puebla, Mexico, for the MILSET Expo-Sciences International was the ultimate celebration of science without borders. Unlike a traditional competition, ESI is all about cultural exchange, dialogue, and sharing the joy of research with students and visitors from every corner of the globe. Standing at our booth, talking with people from different continents, tasting authentic Mexican food together—from tacos and quesadillas to mole and fresh tortillas—and experiencing warm Mexican hospitality as a team taught us that behind every scientific project there are human bonds, and that the best part of research is sharing it with the world.

          </p>
        </div>

        <div class="fiere-carousel-col">
          <div class="mini-carousel" data-carousel> 
            <div class="mini-slide active">
              <img src="/1.our-team.jpg" alt="Stand Bruxelles" loading="lazy" decoding="async" />
              <p class="mini-caption">Our team</p>
            </div>
            <div class="mini-slide">
              <img src="/2. italian delegation the first day of expo.jpg" alt="Presentazione EUCYS" loading="lazy" decoding="async" />
              <p class="mini-caption">Italian delegation the first day of expo</p>
            </div>
            <div class="mini-slide">
              <img src="/3. our stand.jpg" alt="Team EUCYS" loading="lazy" decoding="async" />
              <p class="mini-caption">Our stand</p>
            </div>
            <div class="mini-slide">
              <img src="/4. italian participants at the opening ceremony.jpg" alt="Team EUCYS" loading="lazy" decoding="async" />
              <p class="mini-caption">Italian participants at the opening ceremony</p>
            </div>
            <div class="mini-slide">
              <img src="5. italian delegation visiting Puebla.jpg" alt="Team EUCYS" loading="lazy" decoding="async" />
              <p class="mini-caption">Italian delegation visiting Puebla</p>
            </div>
            <div class="mini-slide">
              <img src="/6. viva mexico! at the cultural event.jpg" alt="Team EUCYS" loading="lazy" decoding="async" />
              <p class="mini-caption">Viva mexico! at the cultural event</p>
            </div>
            <div class="mini-slide">
              <img src="/7. italian delegation at the closing ceremony.jpg" alt="Team EUCYS" loading="lazy" decoding="async" />
              <p class="mini-caption">Italian delegation at the closing ceremony</p>
            </div>
            <button class="mini-arrow prev" aria-label="Precedente">&#10094;</button>
            <button class="mini-arrow next" aria-label="Successiva">&#10095;</button>
          </div>
        </div>
      </div>
    </section>

  </div>

  <script>
    document.querySelectorAll("[data-carousel]").forEach((carousel) => {
      const slides = carousel.querySelectorAll(".mini-slide");
      const prevBtn = carousel.querySelector(".prev");
      const nextBtn = carousel.querySelector(".next");
      let current = 0;

      const showSlide = (index: number) => {
        slides.forEach((s, i) => s.classList.toggle("active", i === index));
      };

      prevBtn?.addEventListener("click", () => {
        current = (current - 1 + slides.length) % slides.length;
        showSlide(current);
      });

      nextBtn?.addEventListener("click", () => {
        current = (current + 1) % slides.length;
        showSlide(current);
      });
    });
  </script>
</Layout>
