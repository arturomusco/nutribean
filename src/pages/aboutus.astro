---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About Us | NutriBean+">
  <div class="page-container">
    <section class="intro-card-white">
      <h1>About Us</h1>
      <p>
        We are three young researchers passionate about chemistry, sustainability, and circular economy. Through the <strong>NutriBean+</strong> project, we investigated how local varieties of chickpeas, soybeans, and agricultural by-products (soybean pods) can become innovative, high-protein, and antioxidant-rich flours for a healthier and more sustainable food system.
      </p>
    </section>

    <section class="team-grid">
      <div class="team-card">
        <div class="team-avatar">PC</div>
        <h3>Pietro Ciceri</h3>
        <p class="team-role">Co-Author &amp; Researcher</p>
        <p>Focused on chemical characterization, physical parameters, and laboratory extraction protocols.</p>
      </div>

      <div class="team-card">
        <div class="team-avatar">DL</div>
        <h3>Davide Lolla</h3>
        <p class="team-role">Co-Author &amp; Researcher</p>
        <p>Focused on nutraceutical evaluation, antioxidant activity, and circular economy applications.</p>
      </div>

      <div class="team-card">
        <div class="team-avatar">NM</div>
        <h3>Noemi Marianna Pia</h3>
        <p class="team-role">Co-Author &amp; Researcher</p>
        <p>Focused on nutritional profiling, agronomic screening, and data analysis of legume varieties.</p>
      </div>
    </section>

    <section class="school-box">
      <h2>Our School &amp; Journey</h2>
      <p>
        Developed at <strong>Istituto Tecnico Tecnologico "Ettore Majorana"</strong>, the project was awarded First Prize at <em>"I Giovani e le Scienze 2023"</em> (FAST) in Milan, earning the opportunity to represent Italy at the 34th European Union Contest for Young Scientists (EUCYS) in Brussels.[cite: 3]
      </p>
    </section>
  </div>
</Layout>
